{
  "name": "rielaapp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && bun run audit",
    "audit": "bun run scripts/audit-source.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "build": "vite build",
    "desktop:build": "bun run build && cargo build --locked --manifest-path src-tauri/Cargo.toml --release",
    "desktop:build:debug": "bun run build && cargo build --locked --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
