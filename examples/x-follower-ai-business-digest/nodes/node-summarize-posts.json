{
  "id": "summarize-posts",
  "description": "Sanitizes untrusted X post data, filters non-AI/non-business chatter, and produces a Telegram-ready digest sorted by view count.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.4-mini",
  "modelFreeze": true,
  "promptTemplateFile": "prompts/summarize-posts.md",
  "output": {
    "description": "Return JSON with when.should_send_telegram, payload.replyText, payload.maxFetchedPostId, and payload.topicDigests.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "shouldSendTelegram": {
          "type": "boolean"
        },
        "maxFetchedPostId": {
          "type": "string"
        },
        "replyText": {
          "type": "string"
        },
        "topicDigests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "sourcePostIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "articleUrl": {
                "type": "string"
              }
            },
            "required": [
              "topic",
              "reason",
              "summary",
              "sourcePostIds"
            ]
          }
        },
        "discardedCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "shouldSendTelegram",
        "maxFetchedPostId",
        "replyText",
        "topicDigests",
        "discardedCount"
      ]
    }
  }
}
