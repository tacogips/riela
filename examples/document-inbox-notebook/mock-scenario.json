{
  "convert-document": {
    "provider": "scenario-mock",
    "model": "riela/file-markdown-convert@1",
    "when": {
      "always": true,
      "has_markdown": true,
      "has_failures": false
    },
    "payload": {
      "status": "ok",
      "addon": "riela/file-markdown-convert",
      "stepId": "convert-document",
      "markdown": "# Mock Document\n\nConverted body text.",
      "documentCount": 1,
      "convertedCount": 1,
      "failedCount": 0,
      "fileMarkdown": {
        "documents": [
          {
            "status": "ok",
            "path": "/mock/inbox/sample.pdf",
            "requestedPath": "/mock/inbox/sample.pdf",
            "fileName": "sample.pdf",
            "format": "pdf",
            "inputByteCount": 1024,
            "markdown": "# Mock Document\n\nConverted body text.",
            "markdownByteCount": 38,
            "truncated": false
          }
        ],
        "documentCount": 1,
        "convertedCount": 1,
        "failedCount": 0,
        "markdown": "# Mock Document\n\nConverted body text.",
        "converter": {
          "path": "/mock/bin/anydoc-swift",
          "source": "path",
          "version": "anydoc-swift 0.1.2"
        }
      },
      "replyText": "Converted 1 document(s) to Markdown."
    }
  }
}
