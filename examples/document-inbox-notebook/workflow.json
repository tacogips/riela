{
  "workflowId": "document-inbox-notebook",
  "description": "Convert a dropped local document (pdf, epub, ...) to Markdown through the external anydoc-swift converter and save it as an imported-material riela notebook.",
  "defaults": {
    "maxLoopIterations": 3,
    "nodeTimeoutMs": 300000
  },
  "entryStepId": "convert-document",
  "nodes": [
    {
      "id": "convert-document",
      "addon": {
        "name": "riela/file-markdown-convert",
        "version": "1",
        "config": {
          "maxDocuments": 1,
          "maxMarkdownBytes": 2000000
        },
        "inputs": {
          "path": "{{workflowInput.path}}"
        }
      }
    },
    {
      "id": "ingest-notebook",
      "addon": {
        "name": "riela/notebook-ingest-pages",
        "version": "1",
        "config": {
          "noteRoot": "{{noteRoot}}",
          "notebookTitle": "{{workflowInput.title}}",
          "sourceDocumentRef": "{{workflowInput.sourceDocumentRef}}",
          "notebookKindTag": "notebook-kind:imported-material",
          "allowLocalFileReferencesOutsideWorkingDirectory": true
        },
        "inputs": {
          "pages": "{{fileMarkdown.documents}}"
        }
      }
    },
    {
      "id": "workflow-output",
      "kind": "output",
      "nodeFile": "nodes/node-workflow-output.json"
    }
  ],
  "steps": [
    {
      "id": "convert-document",
      "nodeId": "convert-document",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "ingest-notebook"
        }
      ]
    },
    {
      "id": "ingest-notebook",
      "nodeId": "ingest-notebook",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "workflow-output"
        }
      ]
    },
    {
      "id": "workflow-output",
      "nodeId": "workflow-output",
      "role": "worker"
    }
  ]
}
