    ],
    "constraints": [
      "Preserve accepted P1-6a/b behavior, P1-6b publication 7d8fc121a4f4469de7a40495282b53c9d813b8d4 and ae7cafe receipt baseline.",
      "One implementation owner for coupled store, runner, signal and selected-host acknowledgment; serial reconciliation of shared files.",
      "All scratch and complete command logs under repository tmp; foreground commands and final exit status.",
      "Only accepted exact files in later commits; no force push; leave P1-6d, P1-7a/b and parent P1 active."
    ],
    "designDecisionsAndRationale": [
      "Use existing WorkStore decisions and reservation as the sole durable causality and fence boundaries so replay and version checks stay shared.",
      "Observe pending requests during the owned run, including a separate CLI process, because an in-memory callback cannot deliver them.",
      "Treat selected-host transport acceptance, lease expiry and heartbeat loss as insufficient proof of worker stop; require worker completion and exact cancelled session snapshot.",
      "Route pending cancellation through acknowledgment instead of generic reconcile to preserve the fence and one-time replacement ordering."
    ],
    "intentionalTradeoffs": [
      "Bounded polling and waits in the existing run lifetime; uncertain results remain visibly fenced for explicit reconciliation.",
      "Keep one coupled implementation plan rather than independent workers with overlapping safety-critical edits."
    ],
    "supportedEdgeCases": [
      "Pre-launch cancellation and authorization/start race",
      "Running local and selected-host interruption",
      "Terminal persistence failure and lost acknowledgment",
      "Completed or non-cancellation failed snapshot racing a request",
      "Lease or heartbeat loss",
      "Reopen/replay and once-only pending replacement"
    ],
    "outOfScopeEdgeCases": [
      "Unrelated baseline failures except source-matched environment-gate classification",
      "Plain workflow behavior changes beyond preserving existing Ctrl-C handling"
