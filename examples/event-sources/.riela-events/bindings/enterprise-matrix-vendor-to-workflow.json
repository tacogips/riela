{
  "id": "enterprise-matrix-vendor-to-workflow",
  "sourceId": "enterprise-matrix",
  "outputDestinations": [
    "enterprise-matrix-vendor-replies"
  ],
  "match": {
    "eventType": "chat.message",
    "conversationId": "!vendor-onboarding:matrix.example"
  },
  "workflowName": "enterprise-matrix-vendor-onboarding",
  "inputMapping": {
    "mode": "event-input",
    "mirrorToHumanInput": true
  },
  "execution": {
    "async": false,
    "allowUnsafeSyncWebhook": true,
    "dedupeWindowMs": 86400000
  },
  "taskPlanning": {
    "enabled": false
  },
  "mailboxBridge": {
    "output": {
      "progress": {
        "mode": "none"
      }
    }
  }
}
