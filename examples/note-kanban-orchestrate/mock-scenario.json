{
  "riela-manager": {
    "provider": "scenario-mock",
    "model": "gpt-5.5",
    "when": { "always": true },
    "payload": { "stage": "start", "policy": "note-kanban-orchestrate" }
  },
  "step1-decompose": {
    "provider": "scenario-mock",
    "model": "gpt-5.5",
    "when": { "always": true },
    "payload": {
      "folderTagName": "orchestrate-demo",
      "tasks": [
        {
          "taskKey": "analysis-brief",
          "title": "Analysis brief",
          "briefMarkdown": "Analyze the request and write a structured brief.",
          "acceptanceMarkdown": "- covers goals\n- covers risks"
        },
        {
          "taskKey": "draft-plan",
          "title": "Draft plan",
          "briefMarkdown": "Draft an execution plan as markdown.",
          "acceptanceMarkdown": "- ordered steps\n- owners noted"
        }
      ]
    }
  },
  "step2-board-setup": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": {
      "status": "ok",
      "addon": "riela/note-kanban-task-create",
      "folderTagName": "orchestrate-demo",
      "initialProgress": "pending",
      "tasks": [
        {
          "taskKey": "analysis-brief",
          "notebookId": "nb-analysis-brief",
          "title": "Analysis brief",
          "briefMarkdown": "Analyze the request and write a structured brief.",
          "acceptanceMarkdown": "- covers goals\n- covers risks",
          "progress": "pending",
          "reused": false
        },
        {
          "taskKey": "draft-plan",
          "notebookId": "nb-draft-plan",
          "title": "Draft plan",
          "briefMarkdown": "Draft an execution plan as markdown.",
          "acceptanceMarkdown": "- ordered steps\n- owners noted",
          "progress": "pending",
          "reused": false
        }
      ]
    }
  },
  "step3-claim": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": { "status": "ok", "conflict": false, "progress": "progress" }
  },
  "step4-execute": {
    "provider": "scenario-mock",
    "model": "gpt-5.5",
    "when": { "always": true },
    "payload": {
      "resultMarkdown": "## Deliverable\n\nDeterministic mock deliverable body.",
      "selfAssessment": "All acceptance criteria addressed in the mock deliverable."
    }
  },
  "step5-record-result": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": { "status": "ok", "noteId": "note-mock-result" }
  },
  "step5b-mark-review": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": { "status": "ok", "conflict": false, "progress": "review" }
  },
  "step6-review": [
    {
      "provider": "scenario-mock",
      "model": "gpt-5.5",
      "when": { "all_pass": false, "needs_rework": true },
      "payload": {
        "round": 1,
        "maxReworkRounds": 3,
        "verdicts": [
          { "taskKey": "analysis-brief", "notebookId": "nb-analysis-brief", "passed": true, "reason": "meets acceptance criteria" },
          { "taskKey": "draft-plan", "notebookId": "nb-draft-plan", "passed": false, "reason": "plan lacks owners" }
        ],
        "passedTasks": [
          { "taskKey": "analysis-brief", "notebookId": "nb-analysis-brief", "title": "Analysis brief", "progress": "review" }
        ],
        "failedTasks": [
          {
            "taskKey": "draft-plan",
            "notebookId": "nb-draft-plan",
            "title": "Draft plan",
            "briefMarkdown": "Draft an execution plan as markdown.",
            "acceptanceMarkdown": "- ordered steps\n- owners noted",
            "progress": "review",
            "round": 2,
            "feedback": "Add an owner for every plan step."
          }
        ]
      }
    },
    {
      "provider": "scenario-mock",
      "model": "gpt-5.5",
      "when": { "all_pass": true, "needs_rework": false },
      "payload": {
        "round": 2,
        "maxReworkRounds": 3,
        "verdicts": [
          { "taskKey": "analysis-brief", "notebookId": "nb-analysis-brief", "passed": true, "reason": "meets acceptance criteria" },
          { "taskKey": "draft-plan", "notebookId": "nb-draft-plan", "passed": true, "reason": "owners added per feedback" }
        ],
        "passedTasks": [
          { "taskKey": "analysis-brief", "notebookId": "nb-analysis-brief", "title": "Analysis brief", "progress": "review" },
          { "taskKey": "draft-plan", "notebookId": "nb-draft-plan", "title": "Draft plan", "progress": "review" }
        ],
        "failedTasks": []
      }
    }
  ],
  "step7-move-done": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": { "status": "ok", "conflict": false, "progress": "done" }
  },
  "step8-summary": {
    "provider": "scenario-mock",
    "model": "gpt-5.5",
    "when": { "always": true },
    "payload": {
      "summaryTitle": "Kanban orchestration: demo run",
      "summaryMarkdown": "## Outcome\n\n- analysis-brief: passed (nb-analysis-brief)\n- draft-plan: passed after 1 rework round (nb-draft-plan)\n- unresolved: none\n- rounds used: 2",
      "goal": "demo orchestration",
      "verdicts": [
        { "taskKey": "analysis-brief", "passed": true },
        { "taskKey": "draft-plan", "passed": true }
      ],
      "unresolvedTasks": []
    }
  },
  "step9-record-summary": {
    "provider": "scenario-mock",
    "when": { "always": true },
    "payload": { "status": "ok", "noteId": "note-mock-summary", "notebookId": "nb-mock-summary" }
  },
  "workflow-output": {
    "provider": "scenario-mock",
    "model": "gpt-5.5",
    "when": { "always": true },
    "payload": {
      "goal": "demo orchestration",
      "verdicts": [
        { "taskKey": "analysis-brief", "passed": true },
        { "taskKey": "draft-plan", "passed": true }
      ],
      "unresolvedTasks": []
    }
  }
}
