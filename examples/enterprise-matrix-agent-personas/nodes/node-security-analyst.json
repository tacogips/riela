{
  "id": "security-analyst",
  "description": "Sora Security Analyst: security detection and containment specialist.",
  "executionBackend": "official/openai-sdk",
  "model": "gpt-5.4-mini",
  "modelFreeze": true,
  "systemPromptTemplateFile": "prompts/enterprise-agent-system.md",
  "promptTemplateFile": "prompts/enterprise-agent-reply.md",
  "variables": {
    "personaId": "security-analyst",
    "personaName": "Sora Security Analyst",
    "role": "security detection and containment specialist",
    "teamSummary": "Aoi Incident Lead (incident commander and default manager); Mei Compliance Counsel (privacy, regulatory, and legal specialist)"
  },
  "output": {
    "description": "Structured chat decision with one mode and at most one handoff.",
    "jsonSchema": {
      "type": "object",
      "required": [
        "replyText",
        "llm_only",
        "run_workflow",
        "memoryEntries"
      ],
      "properties": {
        "replyText": {
          "type": "string"
        },
        "llm_only": {
          "type": "boolean"
        },
        "run_workflow": {
          "type": "boolean"
        },
        "workflowTask": {
          "type": "object",
          "required": ["title", "prompt"],
          "properties": {
            "title": { "type": "string" },
            "prompt": { "type": "string" }
          },
          "additionalProperties": false
        },
        "memoryEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "importance": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  }
}
