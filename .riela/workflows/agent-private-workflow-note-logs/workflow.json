{
  "workflowId": "agent-private-workflow-note-logs",
  "description": "Implement and verify private RielaApp assistant task workflows, Web session deep links, and workflow-run notebooks in Riela Note.",
  "defaults": {
    "maxLoopIterations": 2,
    "nodeTimeoutMs": 1800000
  },
  "entryStepId": "intake-or-plan",
  "nodes": [
    { "id": "intake-or-plan", "nodeFile": "nodes/node-intake-or-plan.json" },
    { "id": "work", "nodeFile": "nodes/node-work.json" },
    { "id": "review", "nodeFile": "nodes/node-review.json" },
    { "id": "verification", "nodeFile": "nodes/node-verification.json" },
    { "id": "workflow-output", "nodeFile": "nodes/node-workflow-output.json" }
  ],
  "steps": [
    {
      "id": "intake-or-plan",
      "nodeId": "intake-or-plan",
      "role": "worker",
      "transitions": [{ "toStepId": "work" }]
    },
    {
      "id": "work",
      "nodeId": "work",
      "role": "worker",
      "transitions": [{ "toStepId": "review" }]
    },
    {
      "id": "review",
      "nodeId": "review",
      "role": "worker",
      "transitions": [{ "toStepId": "verification" }]
    },
    {
      "id": "verification",
      "nodeId": "verification",
      "role": "worker",
      "transitions": [{ "toStepId": "workflow-output" }]
    },
    { "id": "workflow-output", "nodeId": "workflow-output", "role": "worker" }
  ]
}
