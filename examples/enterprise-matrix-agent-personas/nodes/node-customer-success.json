{
  "id": "customer-success",
  "description": "Mio Customer Success: customer communication and adoption specialist.",
  "executionBackend": "official/openai-sdk",
  "model": "gpt-5.4-mini",
  "modelFreeze": true,
  "systemPromptTemplateFile": "prompts/enterprise-agent-system.md",
  "promptTemplateFile": "prompts/enterprise-agent-reply.md",
  "variables": {
    "personaId": "customer-success",
    "personaName": "Mio Customer Success",
    "role": "customer communication and adoption specialist",
    "teamSummary": "Hana Support Lead (support manager and default orchestrator); Rei Product Engineer (product diagnosis and mitigation specialist)"
  },
  "output": {
    "description": "Structured chat decision with one mode and at most one handoff.",
    "jsonSchema": {
      "type": "object",
      "required": [
        "replyText",
        "llm_only",
        "run_workflow",
        "noteEntries"
      ],
      "properties": {
        "replyText": {
          "type": "string"
        },
        "llm_only": {
          "type": "boolean"
        },
        "run_workflow": {
          "type": "boolean"
        },
        "noteEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "importance": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  }
}
