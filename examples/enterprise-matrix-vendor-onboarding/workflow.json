{
  "workflowId": "enterprise-matrix-vendor-onboarding",
  "description": "Vendor onboarding Matrix room with one default manager and two memory-isolated specialists.",
  "defaults": {
    "maxLoopIterations": 24,
    "nodeTimeoutMs": 180000
  },
  "memories": [
    {
      "id": "persona-chat-memory",
      "purpose": "shared persona chat memory stream for enterprise personas",
      "scope": "cross-workflow"
    }
  ],
  "entryStepId": "route-message",
  "nodes": [
    {
      "id": "route-message",
      "addon": {
        "name": "riela/chat-persona-router",
        "version": "1",
        "config": {
          "defaultPersonaId": "procurement-lead",
          "personas": [
            {
              "id": "procurement-lead",
              "name": "Nao Procurement Lead",
              "aliases": [
                "nao",
                "procurement lead",
                "procurement"
              ]
            },
            {
              "id": "finance-analyst",
              "name": "Yuna Finance Analyst",
              "aliases": [
                "yuna",
                "finance analyst",
                "finance"
              ]
            },
            {
              "id": "legal-counsel",
              "name": "Ema Legal Counsel",
              "aliases": [
                "ema",
                "legal counsel",
                "legal"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "read-procurement-lead-own-memory",
      "addon": {
        "name": "riela/chat-persona-memory-read",
        "version": "1",
        "config": {
          "personaId": "procurement-lead",
          "memoryId": "persona-chat-memory",
          "limit": 5
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "read recent procurement-lead memory"
        }
      ]
    },
    {
      "id": "read-procurement-lead-finance-analyst-memory",
      "addon": {
        "name": "riela/chat-persona-memory-read",
        "version": "1",
        "config": {
          "personaId": "finance-analyst",
          "memoryId": "persona-chat-memory",
          "limit": 5
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "read recent finance-analyst memory"
        }
      ]
    },
    {
      "id": "read-procurement-lead-legal-counsel-memory",
      "addon": {
        "name": "riela/chat-persona-memory-read",
        "version": "1",
        "config": {
          "personaId": "legal-counsel",
          "memoryId": "persona-chat-memory",
          "limit": 5
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "read recent legal-counsel memory"
        }
      ]
    },
    {
      "id": "procurement-lead",
      "nodeRef": {
        "workflowId": "enterprise-matrix-agent-personas",
        "nodeId": "procurement-lead"
      }
    },
    {
      "id": "write-procurement-lead-memory",
      "addon": {
        "name": "riela/chat-persona-memory-write",
        "version": "1",
        "config": {
          "personaId": "procurement-lead",
          "personaName": "Nao Procurement Lead",
          "memoryId": "persona-chat-memory",
          "teamPersonaIds": [
            "procurement-lead",
            "finance-analyst",
            "legal-counsel"
          ],
          "maxHandoffTurns": 3
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "persist procurement-lead memory entries"
        }
      ]
    },
    {
      "id": "generate-procurement-lead-workflow",
      "addon": {
        "name": "riela/workflow-create-register-run",
        "version": "1",
        "config": {
          "allowWorkflowCreation": true,
          "executionBackend": "official/openai-sdk",
          "model": "gpt-5.4-mini",
          "workflowIdPrefix": "enterprise-generated"
        }
      }
    },
    {
      "id": "send-procurement-lead-reply",
      "addon": {
        "name": "riela/chat-reply-worker",
        "version": "1",
        "config": {
          "textTemplate": "{{inbox.latest.output.payload.replyText}}",
          "replyAsTemplate": "procurement-lead",
          "visibility": "public",
          "threadPolicy": "same-thread",
          "onMissingTarget": "dry-run"
        }
      }
    },
    {
      "id": "read-finance-analyst-memory",
      "addon": {
        "name": "riela/chat-persona-memory-read",
        "version": "1",
        "config": {
          "personaId": "finance-analyst",
          "memoryId": "persona-chat-memory",
          "limit": 5
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "read recent finance-analyst memory"
        }
      ]
    },
    {
      "id": "finance-analyst",
      "nodeRef": {
        "workflowId": "enterprise-matrix-agent-personas",
        "nodeId": "finance-analyst"
      }
    },
    {
      "id": "write-finance-analyst-memory",
      "addon": {
        "name": "riela/chat-persona-memory-write",
        "version": "1",
        "config": {
          "personaId": "finance-analyst",
          "personaName": "Yuna Finance Analyst",
          "memoryId": "persona-chat-memory",
          "teamPersonaIds": [
            "procurement-lead",
            "finance-analyst",
            "legal-counsel"
          ],
          "maxHandoffTurns": 3
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "persist finance-analyst memory entries"
        }
      ]
    },
    {
      "id": "generate-finance-analyst-workflow",
      "addon": {
        "name": "riela/workflow-create-register-run",
        "version": "1",
        "config": {
          "allowWorkflowCreation": true,
          "executionBackend": "official/openai-sdk",
          "model": "gpt-5.4-mini",
          "workflowIdPrefix": "enterprise-generated"
        }
      }
    },
    {
      "id": "send-finance-analyst-reply",
      "addon": {
        "name": "riela/chat-reply-worker",
        "version": "1",
        "config": {
          "textTemplate": "{{inbox.latest.output.payload.replyText}}",
          "replyAsTemplate": "finance-analyst",
          "visibility": "public",
          "threadPolicy": "same-thread",
          "onMissingTarget": "dry-run"
        }
      }
    },
    {
      "id": "read-legal-counsel-memory",
      "addon": {
        "name": "riela/chat-persona-memory-read",
        "version": "1",
        "config": {
          "personaId": "legal-counsel",
          "memoryId": "persona-chat-memory",
          "limit": 5
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "read recent legal-counsel memory"
        }
      ]
    },
    {
      "id": "legal-counsel",
      "nodeRef": {
        "workflowId": "enterprise-matrix-agent-personas",
        "nodeId": "legal-counsel"
      }
    },
    {
      "id": "write-legal-counsel-memory",
      "addon": {
        "name": "riela/chat-persona-memory-write",
        "version": "1",
        "config": {
          "personaId": "legal-counsel",
          "personaName": "Ema Legal Counsel",
          "memoryId": "persona-chat-memory",
          "teamPersonaIds": [
            "procurement-lead",
            "finance-analyst",
            "legal-counsel"
          ],
          "maxHandoffTurns": 3
        }
      },
      "memories": [
        {
          "id": "persona-chat-memory",
          "purpose": "persist legal-counsel memory entries"
        }
      ]
    },
    {
      "id": "generate-legal-counsel-workflow",
      "addon": {
        "name": "riela/workflow-create-register-run",
        "version": "1",
        "config": {
          "allowWorkflowCreation": true,
          "executionBackend": "official/openai-sdk",
          "model": "gpt-5.4-mini",
          "workflowIdPrefix": "enterprise-generated"
        }
      }
    },
    {
      "id": "send-legal-counsel-reply",
      "addon": {
        "name": "riela/chat-reply-worker",
        "version": "1",
        "config": {
          "textTemplate": "{{inbox.latest.output.payload.replyText}}",
          "replyAsTemplate": "legal-counsel",
          "visibility": "public",
          "threadPolicy": "same-thread",
          "onMissingTarget": "dry-run"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "route-message",
      "nodeId": "route-message",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-procurement-lead-own-memory",
          "label": "target_procurement-lead"
        },
        {
          "toStepId": "read-finance-analyst-memory",
          "label": "target_finance-analyst"
        },
        {
          "toStepId": "read-legal-counsel-memory",
          "label": "target_legal-counsel"
        }
      ]
    },
    {
      "id": "read-procurement-lead-own-memory",
      "nodeId": "read-procurement-lead-own-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-procurement-lead-finance-analyst-memory"
        }
      ]
    },
    {
      "id": "read-procurement-lead-finance-analyst-memory",
      "nodeId": "read-procurement-lead-finance-analyst-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-procurement-lead-legal-counsel-memory"
        }
      ]
    },
    {
      "id": "read-procurement-lead-legal-counsel-memory",
      "nodeId": "read-procurement-lead-legal-counsel-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "procurement-lead"
        }
      ]
    },
    {
      "id": "procurement-lead",
      "nodeId": "procurement-lead",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "write-procurement-lead-memory"
        }
      ]
    },
    {
      "id": "write-procurement-lead-memory",
      "nodeId": "write-procurement-lead-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "generate-procurement-lead-workflow",
          "label": "run_workflow"
        },
        {
          "toStepId": "send-procurement-lead-reply",
          "label": "llm_only"
        }
      ]
    },
    {
      "id": "generate-procurement-lead-workflow",
      "nodeId": "generate-procurement-lead-workflow",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "send-procurement-lead-reply"
        }
      ]
    },
    {
      "id": "send-procurement-lead-reply",
      "nodeId": "send-procurement-lead-reply",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-finance-analyst-memory",
          "label": "handoff_finance-analyst"
        },
        {
          "toStepId": "read-legal-counsel-memory",
          "label": "handoff_legal-counsel"
        }
      ]
    },
    {
      "id": "read-finance-analyst-memory",
      "nodeId": "read-finance-analyst-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "finance-analyst"
        }
      ]
    },
    {
      "id": "finance-analyst",
      "nodeId": "finance-analyst",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "write-finance-analyst-memory"
        }
      ]
    },
    {
      "id": "write-finance-analyst-memory",
      "nodeId": "write-finance-analyst-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "generate-finance-analyst-workflow",
          "label": "run_workflow"
        },
        {
          "toStepId": "send-finance-analyst-reply",
          "label": "llm_only"
        }
      ]
    },
    {
      "id": "generate-finance-analyst-workflow",
      "nodeId": "generate-finance-analyst-workflow",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "send-finance-analyst-reply"
        }
      ]
    },
    {
      "id": "send-finance-analyst-reply",
      "nodeId": "send-finance-analyst-reply",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-procurement-lead-own-memory",
          "label": "handoff_procurement-lead"
        },
        {
          "toStepId": "read-legal-counsel-memory",
          "label": "handoff_legal-counsel"
        }
      ]
    },
    {
      "id": "read-legal-counsel-memory",
      "nodeId": "read-legal-counsel-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "legal-counsel"
        }
      ]
    },
    {
      "id": "legal-counsel",
      "nodeId": "legal-counsel",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "write-legal-counsel-memory"
        }
      ]
    },
    {
      "id": "write-legal-counsel-memory",
      "nodeId": "write-legal-counsel-memory",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "generate-legal-counsel-workflow",
          "label": "run_workflow"
        },
        {
          "toStepId": "send-legal-counsel-reply",
          "label": "llm_only"
        }
      ]
    },
    {
      "id": "generate-legal-counsel-workflow",
      "nodeId": "generate-legal-counsel-workflow",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "send-legal-counsel-reply"
        }
      ]
    },
    {
      "id": "send-legal-counsel-reply",
      "nodeId": "send-legal-counsel-reply",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "read-procurement-lead-own-memory",
          "label": "handoff_procurement-lead"
