{
  "id": "enterprise-matrix-security-to-workflow",
  "sourceId": "enterprise-matrix",
  "outputDestinations": [
    "enterprise-matrix-security-replies"
  ],
  "match": {
    "eventType": "chat.message",
    "conversationId": "!security-incident:matrix.example"
  },
  "workflowName": "enterprise-matrix-security-incident",
  "inputMapping": {
    "mode": "event-input",
    "mirrorToHumanInput": true
  },
  "execution": {
    "async": false,
    "allowUnsafeSyncWebhook": true,
    "dedupeWindowMs": 86400000
  },
  "mailboxBridge": {
    "output": {
      "progress": {
        "mode": "none"
      }
    }
  }
}
