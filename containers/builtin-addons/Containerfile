FROM rust:1.88.0-bookworm AS anydoc-source
ENV CARGO_PROFILE_RELEASE_LTO=false
WORKDIR /anydoc-swift
RUN git init . && git remote add origin https://github.com/tacogips/anydoc-swift.git && \
    git fetch --depth 1 origin 0aa4756d0ce3f97cc94f1de9efe26879808097c8 && git checkout --detach FETCH_HEAD
RUN --mount=type=cache,id=riela-anydoc-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=riela-anydoc-rust188,target=/anydoc-swift/native/anydoc-ffi/target,sharing=locked \
    cargo build --manifest-path native/anydoc-ffi/Cargo.toml --release --locked --jobs 4 && \
    scripts/build-native.sh --prefix /anydoc-native
COPY scripts/container-gateway-support/AnydocFFISmoke.c /anydoc-smoke.c
RUN cc -I/anydoc-native/include /anydoc-smoke.c /anydoc-native/lib/libanydoc_ffi.a \
    -lm -ldl -lpthread -o /anydoc-smoke && /anydoc-smoke

FROM swift:6.3.3-noble@sha256:c2f3ac2eb806ce43f68859c3d52bd3bb1cfc88672fb3a948b76e136d98e39278 AS gmail-source
WORKDIR /gmail-gateway
RUN git init . && git remote add origin https://github.com/tacogips/gmail-gateway.git && \
    git fetch --depth 1 origin 4ce54035694bbcbe88c33a4de3f5905677370b0e && git checkout --detach FETCH_HEAD

FROM swift:6.3.3-noble@sha256:c2f3ac2eb806ce43f68859c3d52bd3bb1cfc88672fb3a948b76e136d98e39278 AS analytics-source
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /google-analytics-gateway
RUN git init . && git remote add origin https://github.com/tacogips/google-analytics-gateway.git && \
    git fetch --depth 1 origin 6b5bf1eda3d0c6ba73439b398ffd616e6b0834e0 && git checkout --detach FETCH_HEAD
COPY scripts/prepare-container-gateway-source.py /prepare.py
RUN python3 /prepare.py analytics /google-analytics-gateway --crypto-version 4.5.2

FROM swift:6.3.3-noble@sha256:c2f3ac2eb806ce43f68859c3d52bd3bb1cfc88672fb3a948b76e136d98e39278 AS documents-source
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /google-documents-gateway
RUN git init . && git remote add origin https://github.com/tacogips/google-documents-gateway.git && \
    git fetch --depth 1 origin dadc2f7d0070f92df07278873262f9f7aad5d16e && git checkout --detach FETCH_HEAD
COPY scripts/prepare-container-gateway-source.py /prepare.py
COPY scripts/container-gateway-support /container-gateway-support
RUN python3 /prepare.py documents /google-documents-gateway --crypto-version 4.5.2
RUN swiftc /container-gateway-support/GatewayPOSIX.swift \
    /container-gateway-support/GatewayPOSIXSmoke.swift -o /posix-smoke && /posix-smoke

FROM swift:6.3.3-noble@sha256:c2f3ac2eb806ce43f68859c3d52bd3bb1cfc88672fb3a948b76e136d98e39278 AS build
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev python3 pkg-config && rm -rf /var/lib/apt/lists/*
# Rust's ARM64 static library uses relocations unsupported by GNU gold.
# Provision LLD only when it is absent from the Swift builder toolchain.
RUN if ! command -v ld.lld >/dev/null 2>&1; then \
    apt-get update && apt-get install -y --no-install-recommends lld && rm -rf /var/lib/apt/lists/*; fi
COPY --from=anydoc-source /anydoc-swift/Package.swift /anydoc-swift/Package.swift
COPY --from=anydoc-source /anydoc-swift/Sources /anydoc-swift/Sources
COPY --from=anydoc-source /anydoc-native /anydoc-native
ENV PKG_CONFIG_PATH="/anydoc-native/pkgconfig"
COPY --from=gmail-source /gmail-gateway /gmail-gateway
COPY --from=analytics-source /google-analytics-gateway /google-analytics-gateway
COPY --from=documents-source /google-documents-gateway /google-documents-gateway
WORKDIR /src
COPY Package.swift Package.resolved ./
COPY Packages ./Packages
COPY Sources ./Sources
COPY Tests ./Tests
COPY Resources ./Resources
COPY scripts/prepare-container-gateway-source.py /prepare.py
RUN python3 /prepare.py riela /src
# Keep incremental compiler outputs in the builder, never in the runtime image.
# The lock prevents simultaneous builds from mutating one SwiftPM directory.
RUN --mount=type=cache,id=riela-builtin-swift633,target=/src/.build,sharing=locked \
    swift build -c release --product riela --jobs 4 -Xswiftc -use-ld=lld && \
    mkdir /install && cp .build/release/riela /install/ && \
    for resource in .build/release/*.resources; do if [ -d "$resource" ]; then cp -R "$resource" /install/; fi; done

# SwiftPM release executables still contain DWARF debug sections by default.
# Keep runtime symbols and unwind data while dropping build-only debug data.
RUN strip --strip-unneeded /install/riela && \
    printf '%s\n' '#!/bin/sh' 'exec /opt/riela/riela __riela-addon-worker "$@"' > /install/riela-addon-worker && \
    chmod 755 /install/riela-addon-worker

COPY scripts/collect-swift-runtime.sh /collect-swift-runtime.sh
RUN sh /collect-swift-runtime.sh /runtime-swift /install/riela

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata libcurl4t64 libxml2 libsqlite3-0 libstdc++6 libgcc-s1 libssl3t64 zlib1g git openssh-client && rm -rf /var/lib/apt/lists/*
COPY --from=build /runtime-swift/ /usr/lib/swift/linux/
COPY --from=build /install/ /opt/riela/
ENV LD_LIBRARY_PATH="/usr/lib/swift/linux"
ENV PATH="/opt/riela:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENTRYPOINT ["riela-addon-worker"]
