FROM swift:6.3.3-noble@sha256:c2f3ac2eb806ce43f68859c3d52bd3bb1cfc88672fb3a948b76e136d98e39278 AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
ARG GATEWAY_REVISION=5bbcb03bcd0ef09249081694b1a75dfc3a1ca2e1
WORKDIR /src
RUN git init . && git remote add origin https://github.com/tacogips/gmail-gateway.git && \
    git fetch --depth 1 origin "$GATEWAY_REVISION" && git checkout --detach FETCH_HEAD
COPY prepare-container-gateway-source.py /prepare.py
COPY container-gateway-support /container-gateway-support
RUN python3 /prepare.py gmail /src
RUN swift build -c release --product gmail-gateway-reader --jobs 4 && \
    swift build -c release --product gmail-gateway-draft --jobs 4 && \
    swift build -c release --product gmail-gateway-sender --jobs 4

COPY collect-swift-runtime.sh /collect-swift-runtime.sh
RUN sh /collect-swift-runtime.sh /runtime-swift /src/.build/release/gmail-gateway-reader /src/.build/release/gmail-gateway-draft /src/.build/release/gmail-gateway-sender

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata libcurl4t64 libxml2 libstdc++6 libgcc-s1 libssl3t64 zlib1g && rm -rf /var/lib/apt/lists/*
COPY --from=build /runtime-swift/ /usr/lib/swift/linux/
ENV LD_LIBRARY_PATH="/usr/lib/swift/linux"
COPY --from=build /src/.build/release/gmail-gateway-reader /src/.build/release/gmail-gateway-draft /src/.build/release/gmail-gateway-sender /usr/local/libexec/
# Foundation resolves the passwd home for credential lifecycle locks. Keep it
# private and ephemeral under the runtime's writable /tmp, including --entrypoint.
RUN useradd --uid 10001 --home-dir /tmp/riela-gmail --no-create-home --shell /usr/sbin/nologin riela-gmail
COPY entrypoint.sh /usr/local/bin/gmail-gateway-reader
RUN chmod 755 /usr/local/bin/gmail-gateway-reader && \
    ln -s gmail-gateway-reader /usr/local/bin/gmail-gateway-draft && \
    ln -s gmail-gateway-reader /usr/local/bin/gmail-gateway-sender
ENV HOME="/tmp/riela-gmail"
USER 10001:10001
ENTRYPOINT ["gmail-gateway-reader"]
