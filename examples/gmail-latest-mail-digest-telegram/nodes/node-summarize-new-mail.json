{
  "id": "summarize-new-mail",
  "description": "Summarizes newly seen Gmail messages into a compact Telegram digest.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.4-mini",
  "modelFreeze": true,
  "promptTemplateFile": "prompts/summarize-new-mail.md",
  "variables": {
    "codexAdditionalArgs": [
      "--sandbox",
      "workspace-write"
    ]
  },
  "output": {
    "description": "Return JSON with when.should_send_telegram, payload.replyText, payload.messageDigests, and payload.fetchedMessageIds.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "replyText": { "type": "string" },
        "messageDigests": { "type": "array" },
        "fetchedMessageIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["replyText"]
    }
  }
}
