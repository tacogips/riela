{
  "id": "document-inbox-to-notebook",
  "sourceId": "document-inbox",
  "match": {
    "eventType": "file.change.created"
  },
  "workflowName": "document-inbox-notebook",
  "inputMapping": {
    "mode": "template",
    "template": {
      "path": "{{event.input.file.absolutePath}}",
      "title": "{{event.input.file.name}}",
      "sourceDocumentRef": "{{event.input.file.absolutePath}}"
    },
    "mirrorToHumanInput": false
  }
}
