{
  "workflowId": "note-kanban-orchestrate",
  "description": "Decompose one task into Riela Note kanban cards under a folder tag, execute them in parallel through pending → progress → review, review every card, rework failures for a bounded number of rounds, then move passed cards to done and publish a summary.",
  "defaults": {
    "maxLoopIterations": 10,
    "nodeTimeoutMs": 600000
  },
  "prompts": {
    "rielaPromptTemplate": "Coordinate {{workflowId}}. Step 1 decomposes workflowInput.task into subtasks whose deliverable is notebook content only. Step 2 creates one kanban card per subtask under the folder tag. The fanout runs each card through claim, execute, record, and mark-review. Step 6 reviews every card: when every card passes, dispatch the finalize fanout that moves passed cards to done and continues to the summary; when failures remain and rounds are not exhausted, dispatch the rework fanout; when rounds are exhausted, finalize with the unresolved cards reported. Finish after the summary note is recorded and the root output is published.",
    "workerSystemPromptTemplate": "Return concise business JSON only. Keep taskKey, notebookId, progress values, verdicts, and round counters explicit."
  },
  "managerStepId": "riela-manager",
  "entryStepId": "riela-manager",
  "nodes": [
    {
      "id": "riela-manager",
      "nodeFile": "nodes/node-riela-manager.json"
    },
    {
      "id": "step1-decompose",
      "nodeFile": "nodes/node-step1-decompose.json"
    },
    {
      "id": "step2-board-setup",
      "addon": {
        "name": "riela/note-kanban-task-create",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}",
          "folderTagName": "{{_rielaInput.latest.payload.folderTagName}}",
          "initialProgress": "pending",
          "runLabel": "note-kanban-orchestrate"
        },
        "inputs": {
          "tasks": "{{_rielaInput.latest.payload.tasks}}"
        }
      }
    },
    {
      "id": "step3-claim",
      "addon": {
        "name": "riela/note-kanban-move",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}"
        },
        "inputs": {
          "notebookId": "{{task.notebookId}}",
          "to": "progress",
          "expectedFrom": "{{task.progress}}"
        }
      }
    },
    {
      "id": "step4-execute",
      "nodeFile": "nodes/node-step4-execute.json"
    },
    {
      "id": "step5-record-result",
      "addon": {
        "name": "riela/note-create",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}",
          "provenance": "ai",
          "assignedBy": "note-kanban-orchestrate"
        },
        "inputs": {
          "notebookId": "{{task.notebookId}}",
          "bodyMarkdown": "{{_rielaInput.latest.payload.resultMarkdown}}"
        }
      }
    },
    {
      "id": "step5b-mark-review",
      "addon": {
        "name": "riela/note-kanban-move",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}"
        },
        "inputs": {
          "notebookId": "{{task.notebookId}}",
          "to": "review",
          "expectedFrom": "progress"
        }
      }
    },
    {
      "id": "step6-review",
      "nodeFile": "nodes/node-step6-review.json"
    },
    {
      "id": "step7-move-done",
      "addon": {
        "name": "riela/note-kanban-move",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}"
        },
        "inputs": {
          "notebookId": "{{task.notebookId}}",
          "to": "done",
          "expectedFrom": "review"
        }
      }
    },
    {
      "id": "step8-summary",
      "nodeFile": "nodes/node-step8-summary.json"
    },
    {
      "id": "step9-record-summary",
      "addon": {
        "name": "riela/note-create",
        "version": "1",
        "config": {
          "noteRoot": "{{workflowInput.noteRoot}}",
          "notebookKindTag": "notebook-kind:user-memo",
          "provenance": "ai",
          "assignedBy": "note-kanban-orchestrate"
        },
        "inputs": {
          "notebookTitle": "{{_rielaInput.latest.payload.summaryTitle}}",
          "bodyMarkdown": "{{_rielaInput.latest.payload.summaryMarkdown}}"
        }
      }
    },
    {
      "id": "workflow-output",
      "kind": "output",
      "nodeFile": "nodes/node-workflow-output.json"
    }
  ],
  "steps": [
    {
      "id": "riela-manager",
      "nodeId": "riela-manager",
      "description": "Start the kanban orchestration and hand execution to the decomposition worker.",
      "role": "manager",
      "transitions": [
        {
          "toStepId": "step1-decompose"
        }
      ]
    },
    {
      "id": "step1-decompose",
      "nodeId": "step1-decompose",
      "description": "Decompose the requested task into notebook-content subtasks with stable taskKeys.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step2-board-setup"
        }
      ]
    },
    {
      "id": "step2-board-setup",
      "nodeId": "step2-board-setup",
      "description": "Idempotently create one kanban card per subtask under the folder tag.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step3-claim",
          "fanout": {
            "groupId": "task-execution",
            "itemsFrom": "/tasks",
            "itemVariable": "task",
            "concurrency": 4,
            "joinStepId": "step6-review",
            "failurePolicy": "collect-partial",
            "resultOrder": "input"
          }
        }
      ]
    },
    {
      "id": "step3-claim",
      "nodeId": "step3-claim",
      "description": "Claim the card by moving it to progress with a compare-and-set guard; a conflict skips straight to the join.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step4-execute",
          "label": "!(conflict)"
        },
        {
          "toStepId": "step6-review",
          "label": "conflict"
        }
      ]
    },
    {
      "id": "step4-execute",
      "nodeId": "step4-execute",
      "description": "Execute the subtask and emit the result markdown with a self-assessment.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step5-record-result"
        }
      ]
    },
    {
      "id": "step5-record-result",
      "nodeId": "step5-record-result",
      "description": "Record the execution result as a note on the card's notebook.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step5b-mark-review"
        }
      ]
    },
    {
      "id": "step5b-mark-review",
      "nodeId": "step5b-mark-review",
      "description": "Move the card to review after the result note is recorded.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step6-review"
        }
      ]
    },
    {
      "id": "step6-review",
      "nodeId": "step6-review",
      "description": "Review every card from the joined branch records; pass everything, dispatch a bounded rework round, or finalize with unresolved cards reported.",
      "role": "worker",
      "loop": {
        "role": "gate",
        "gateId": "kanban-review"
      },
      "transitions": [
        {
          "toStepId": "step7-move-done",
          "label": "all_pass",
          "fanout": {
            "groupId": "finalize-done",
            "itemsFrom": "/passedTasks",
            "itemVariable": "task",
            "concurrency": 4,
            "joinStepId": "step8-summary",
            "failurePolicy": "collect-partial",
            "resultOrder": "input"
          }
        },
        {
          "toStepId": "step3-claim",
          "label": "needs_rework",
          "fanout": {
            "groupId": "task-rework",
            "itemsFrom": "/failedTasks",
            "itemVariable": "task",
            "concurrency": 4,
            "joinStepId": "step6-review",
            "failurePolicy": "collect-partial",
            "resultOrder": "input"
          }
        },
        {
          "toStepId": "step7-move-done",
          "label": "!(all_pass || needs_rework)",
          "fanout": {
            "groupId": "finalize-exhausted",
            "itemsFrom": "/passedTasks",
            "itemVariable": "task",
            "concurrency": 4,
            "joinStepId": "step8-summary",
            "failurePolicy": "collect-partial",
            "resultOrder": "input"
          }
        }
      ]
    },
    {
      "id": "step7-move-done",
      "nodeId": "step7-move-done",
      "description": "Move a passed card from review to done.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step8-summary"
        }
      ]
    },
    {
      "id": "step8-summary",
      "nodeId": "step8-summary",
      "description": "Compose the orchestration summary from the review verdicts and finalize records.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step9-record-summary"
        }
      ]
    },
    {
      "id": "step9-record-summary",
      "nodeId": "step9-record-summary",
      "description": "Record the summary as a memo notebook in the note store.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "workflow-output"
        }
      ]
    },
    {
      "id": "workflow-output",
      "nodeId": "workflow-output",
      "description": "Publish the final orchestration outcome.",
      "role": "worker"
    }
  ]
}
